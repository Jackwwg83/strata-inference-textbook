  "chapter": "03",
  "anchor": "sec-1"
 },
 {
  "term": "形状",
  "key": "shape",
  "en": "shape",
  "meaning": "张量每个轴各有多长，比如 2 × 3 的矩阵有 2 行 3 列。",
  "chapter": "03",
  "anchor": "sec-1",
  "auto": false
 },
 {
