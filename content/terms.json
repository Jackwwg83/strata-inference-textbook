  "anchor": "sec-2"
 },
 {
  "term": "哈希函数",
  "key": "hash-function",
  "en": "hash function",
  "meaning": "把任意输入搅成一个看似杂乱、但每次都相同的数的规则，常用来决定数据放在哪。",
