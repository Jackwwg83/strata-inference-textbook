  "anchor": "c21-parallelism"
 },
 {
  "term": "张量并行",
  "key": "tensor-parallelism",
  "en": "tensor parallelism",
  "meaning": "把同一层的大矩阵拆到多张卡上同时算，每层都要合并结果，通信频繁。",
