  "chapter": "07",
  "anchor": "c07-normalization"
 },
 {
  "term": "均方根",
  "key": "rms",
  "en": "root mean square (RMS)",
  "meaning": "各分量平方的平均再开根号，RMS 归一化后每个分量的平均大小是 1。",
