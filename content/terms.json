  "chapter": "03",
  "anchor": "c03-memory-layout"
 },
 {
  "term": "列主序",
  "key": "column-major",
  "en": "column-major order",
  "meaning": "把表格一列接一列存进内存的布局，同一列的数地址相邻。",
  "chapter": "03",
  "anchor": "c03-memory-layout"
 },
 {
  "term": "步长",
