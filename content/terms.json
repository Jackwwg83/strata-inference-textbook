  "chapter": "24",
  "anchor": "c24-cancel"
 },
 {
  "term": "检查点",
  "key": "cancellation-point",
  "en": "cancellation point",
  "meaning": "干活的一方约好查看取消标志的位置，取消最快也要等运行到下一个检查点。",
  "chapter": "24",
  "anchor": "c24-cancel",
  "auto": false
 },
 {
  "term": "看门狗",
  "key": "watchdog",
  "en": "watchdog",
  "meaning": "定时检查某个部件有没有动静，太久没反应就判定它出了问题。",
  "chapter": "24",
  "anchor": "sec-4"
 },
 {
  "term": "认证",
  "key": "authentication",
  "en": "authentication",
  "meaning": "确认“你是谁”，比如核对请求里带的 API Key 对不对。",
  "chapter": "24",
  "anchor": "c24-auth",
  "auto": false
 },
 {
  "term": "授权",
  "key": "authorization",
  "en": "authorization",
