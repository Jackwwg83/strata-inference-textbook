  "anchor": "c24-process-thread"
 },
 {
  "term": "协作式取消",
  "key": "cooperative-cancellation",
  "en": "cooperative cancellation",
  "meaning": "外部只设取消标志，干活的一方在检查点看到后自己收拾干净再退出。",
  "chapter": "24",
  "anchor": "c24-cancel"
 },
 {
  "term": "取消标志",
  "key": "cancel-flag",
  "en": "cancellation flag",
