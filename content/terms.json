  "anchor": "c19-ema"
 },
 {
  "term": "提示词查找",
  "key": "prompt-lookup",
  "en": "prompt lookup",
  "meaning": "在上下文里找到和正在写的内容重复的一段，把它后面的 token 拿来当草稿。",
