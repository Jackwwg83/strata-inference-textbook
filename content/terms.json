  "anchor": "c19-expected-value"
 },
 {
  "term": "指数移动平均",
  "key": "ema",
  "en": "exponential moving average (EMA)",
  "meaning": "每来一个新数据就把估计值往它挪一小步，越旧的数据权重越小，只需存一个数。",
