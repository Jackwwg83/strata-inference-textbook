  "chapter": "09",
  "anchor": "c09-outer-product"
 },
 {
  "term": "秩",
  "key": "rank",
  "en": "matrix rank",
  "meaning": "矩阵里真正互相独立的方向有几个，外积得到的表秩为 1。",
  "chapter": "09",
  "anchor": "c09-outer-product"
 },
 {
  "term": "秩一更新",
  "key": "rank-one-update",
  "en": "rank-one update",
  "meaning": "把一个外积加到矩阵上，GDN 用它把一对键和值写进状态。",
