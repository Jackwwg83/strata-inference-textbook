  "chapter": "09",
  "anchor": "c09-rnn-state"
 },
 {
  "term": "循环神经网络",
  "key": "rnn",
  "en": "recurrent neural network (RNN)",
  "meaning": "用可训练的网络按“旧状态加新输入”逐步更新一个固定大小状态的模型。",
