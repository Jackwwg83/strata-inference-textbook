  "anchor": "sec-1",
  "auto": false
 },
 {
  "term": "流水线并行",
  "key": "pipeline-parallelism",
  "en": "pipeline parallelism",
  "meaning": "按层把模型分段放到多张卡上，数据走完上一段再进入下一段。",
