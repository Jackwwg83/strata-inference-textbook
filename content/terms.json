  "anchor": "sec-1"
 },
 {
  "term": "期望值",
  "key": "expected-value",
  "en": "expected value",
  "meaning": "按概率加权的平均结果，这里指平均每轮能拿到几个 token。",
  "chapter": "19",
  "anchor": "sec-2"
 },
 {
  "term": "条件接受率",
  "key": "conditional-acceptance",
  "en": "conditional acceptance rate",
  "meaning": "在先前草稿都被接受的条件下，本位置被接受的概率。",
  "chapter": "19",
  "anchor": "sec-2"
 },
 {
  "term": "几何级数",
  "key": "geometric-series",
  "en": "geometric series",
  "meaning": "每一项都是前一项乘同一个数的和，所以多猜草稿的收益越来越小。",
