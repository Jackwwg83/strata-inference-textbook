  "anchor": "c21-interconnect"
 },
 {
  "term": "通道",
  "key": "pcie-lane",
  "en": "PCIe lane",
  "meaning": "PCIe 里并排的一条数据线路，像公路的一条车道，×16 就是 16 条。",
  "chapter": "21",
  "anchor": "c21-interconnect",
  "auto": false
 },
 {
  "term": "NVLink",
  "key": "nvlink",
  "en": "NVLink",
  "meaning": "英伟达显卡之间的专用高速连接，带宽比 PCIe 高得多，家用双卡通常没有。",
  "chapter": "21",
  "anchor": "c21-interconnect"
 },
 {
  "term": "源代码",
  "key": "source-code",
  "en": "source code",
  "meaning": "程序员写的、人能读懂的程序文字。",
  "chapter": "22",
  "anchor": "sec-1"
 },
 {
  "term": "机器码",
