  "anchor": "sec-5"
 },
 {
  "term": "前缀",
  "key": "prefix",
  "en": "prefix",
  "meaning": "和上一次请求开头完全相同的那部分 token。",
  "chapter": "20",
  "anchor": "sec-1",
  "auto": false
 },
 {
  "term": "前缀复用",
  "key": "prefix-reuse",
  "en": "prefix reuse (prompt cache)",
  "meaning": "已读过的前缀不再重读，直接从断点接着读，长对话因此不会越聊越慢。",
  "chapter": "20",
  "anchor": "sec-1"
 },
 {
  "term": "steering",
  "key": "steering",
  "en": "steering (control vector)",
  "meaning": "Strata 可选的控制向量功能，开启后会改动模型许多层的中间结果。",
  "chapter": "20",
  "anchor": "sec-2"
 },
 {
  "term": "快照",
  "key": "snapshot",
  "en": "snapshot",
  "meaning": "把某一时刻的全部状态存下来，以后可以回到那一刻，像游戏存档。",
  "chapter": "20",
  "anchor": "sec-3"
 },
 {
  "term": "链",
  "key": "checkpoint-chain",
  "en": "checkpoint chain",
  "meaning": "Strata 会话里的检查点按长度排成一串，每一个都是下一个的前缀。",
  "chapter": "20",
  "anchor": "sec-4"
 },
 {
  "term": "写时复制",
  "key": "copy-on-write",
  "en": "copy-on-write (COW)",
  "meaning": "多方先共用同一份数据，谁要改哪一块才复制哪一块。",
  "chapter": "20",
  "anchor": "c20-copy-on-write"
 },
 {
  "term": "引用计数",
  "key": "reference-count",
  "en": "reference counting",
  "meaning": "记录一块数据当前有几个使用者，降到 0 才能释放。",
  "chapter": "20",
  "anchor": "c20-copy-on-write"
 },
 {
  "term": "层切分",
  "key": "layer-split",
  "en": "layer split",
  "meaning": "把模型的层按顺序切成几段，每张显卡负责连续的一段，只在段与段之间交接数据。",
