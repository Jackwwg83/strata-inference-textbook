  "chapter": "22",
  "anchor": "c22-compiler"
 },
 {
  "term": "内核",
  "key": "kernel",
  "en": "kernel",
  "meaning": "专门做一段核心计算的小程序，在 GPU 上由 CPU 发起、交给大量线程同时执行。",
  "chapter": "22",
  "anchor": "sec-2",
  "auto": false
 },
 {
  "term": "CPUID",
  "key": "cpuid",
