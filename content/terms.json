[
 {
  "term": "token",
  "key": "token",
  "en": "token",
  "meaning": "模型读写文字的最小单位，可能是一个字、半个词或一个标点，模型只认它的编号。",
  "chapter": "01",
  "anchor": "sec-1"
 },
 {
  "term": "分词器",
  "key": "tokenizer",
  "en": "tokenizer",
  "meaning": "把文字切成 token 再换成整数编号的程序，每个模型都自带一套。",
  "chapter": "01",
  "anchor": "sec-1"
 },
 {
  "term": "采样",
  "key": "sampling",
  "en": "sampling",
  "meaning": "按模型给出的概率，从候选 token 里挑出一个作为下一个输出。",
  "chapter": "01",
  "anchor": "sec-1"
 },
 {
  "term": "自回归",
  "key": "autoregressive",
  "en": "autoregressive",
  "meaning": "每一步都把已生成的内容当作输入再生成下一个，所以回答只能一个 token 接一个地出。",
  "chapter": "01",
  "anchor": "sec-1"
 },
 {
  "term": "prefill",
  "key": "prefill",
  "en": "prefill",
  "meaning": "读题阶段：把整段提问一次读进模型，已知的 token 可以一起算，所以快。",
  "chapter": "01",
  "anchor": "sec-2"
 },
 {
  "term": "decode",
  "key": "decode",
  "en": "decode",
  "meaning": "写答案阶段：每个新 token 都依赖上一个，只能一个一个地生成。",
  "chapter": "01",
  "anchor": "sec-2"
 },
 {
  "term": "存储层次结构",
  "key": "memory-hierarchy",
  "en": "memory hierarchy",
  "meaning": "把快而小、慢而大的存储叠成多层，最常用的数据放在最快的一层。",
  "chapter": "01",
  "anchor": "c01-memory-hierarchy"
 },
 {
  "term": "带宽",
  "key": "bandwidth",
  "en": "bandwidth",
  "meaning": "每秒能搬多少字节，推理每出一个 token 都要读大量参数，所以最看重它。",
  "chapter": "01",
  "anchor": "c01-memory-hierarchy"
 },
 {
  "term": "延迟",
  "key": "latency",
  "en": "latency",
  "meaning": "从发出请求到拿到结果要等的时间，数据再少也要付这笔等待。",
  "chapter": "01",
  "anchor": "c01-memory-hierarchy",
  "auto": false
 },
 {
  "term": "字节级 BPE",
  "key": "byte-level-bpe",
  "en": "byte-level BPE",
  "meaning": "一种分词方法：从单个字节出发，把常挨在一起的片段反复合并成 token。",
  "chapter": "02",
  "anchor": "sec-1"
 },
 {
  "term": "聊天模板",
  "key": "chat-template",
  "en": "chat template",
  "meaning": "给对话加上角色标记、系统提示等固定格式的规则，模型读到的是套好模板的全文。",
  "chapter": "02",
  "anchor": "sec-1"
 },
 {
  "term": "链式法则",
  "key": "chain-rule",
  "en": "chain rule of probability",
  "meaning": "一串事件的联合概率等于各步条件概率的连乘，整句话的概率就这样算出。",
  "chapter": "02",
  "anchor": "sec-2"
 },
 {
  "term": "条件概率",
  "key": "conditional-probability",
  "en": "conditional probability",
  "meaning": "已知 B 发生时 A 发生的概率，写作 P(A | B)，模型每步给出的正是这种概率。",
  "chapter": "02",
  "anchor": "c02-chain-rule"
 },
 {
  "term": "分数",
  "key": "logits",
  "en": "logits",
  "meaning": "模型最后一层给每个候选 token 打的原始分，可正可负，经过 softmax 才变成概率。",
  "chapter": "02",
  "anchor": "sec-3",
  "auto": false
 },
 {
  "term": "logits",
  "key": "logits",
  "en": "logits",
  "meaning": "模型最后一层给每个候选 token 打的原始分，可正可负，经过 softmax 才变成概率。",
  "chapter": "02",
  "anchor": "sec-3",
  "auto": false
 },
 {
  "term": "softmax",
  "key": "softmax",
  "en": "softmax",
  "meaning": "把一串分数变成全为正、总和为 1 的概率，先减去最大值可以防止溢出。",
  "chapter": "02",
  "anchor": "sec-3"
 },
 {
  "term": "温度",
  "key": "temperature",
  "en": "temperature",
  "meaning": "采样前把分数除以的数 T，小于 1 让回答更保守，大于 1 让回答更发散。",
  "chapter": "02",
  "anchor": "sec-3",
  "auto": false
 },
 {
  "term": "浮点数",
  "key": "floating-point",
  "en": "floating-point number",
  "meaning": "计算机存小数的方式，分符号、指数、尾数三段，位数有限，所以范围和精度都有限。",
  "chapter": "02",
  "anchor": "c02-softmax-overflow"
 },
 {
  "term": "上溢",
  "key": "float-overflow",
  "en": "floating-point overflow",
  "meaning": "浮点计算结果超过能表示的最大值，变成无穷大。",
  "chapter": "02",
  "anchor": "c02-softmax-overflow"
 },
 {
  "term": "NaN",
  "key": "nan",
  "en": "NaN (Not a Number)",
  "meaning": "浮点里表示“不是一个数”的特殊值，如 ∞ ÷ ∞，一旦出现会污染后续结果。",
  "chapter": "02",
  "anchor": "c02-softmax-overflow"
 },
 {
  "term": "数值稳定",
  "key": "numerical-stability",
  "en": "numerical stability",
  "meaning": "数学上等价、但在有限精度下不会溢出或严重失真的算法写法。",
  "chapter": "02",
  "anchor": "c02-softmax-overflow"
 },
 {
  "term": "逆变换采样",
  "key": "inverse-transform-sampling",
  "en": "inverse transform sampling",
  "meaning": "先算累计概率，再找第一个超过随机数 u 的位置，以此按概率挑出一个 token。",
  "chapter": "02",
  "anchor": "sec-4"
 },
 {
  "term": "贪心",
  "key": "greedy",
  "en": "greedy decoding",
  "meaning": "不掷骰子，每步都选概率最高的 token，所以输出完全确定。",
  "chapter": "02",
  "anchor": "sec-4"
 },
 {
  "term": "伪随机数",
  "key": "pseudorandom-number",
  "en": "pseudorandom number",
  "meaning": "由公式算出、看上去毫无规律的数列，给定种子就能完全重现。",
  "chapter": "02",
  "anchor": "c02-prng"
 },
 {
  "term": "种子",
  "key": "seed",
  "en": "random seed",
  "meaning": "伪随机数公式的起点，种子相同数列就相同，可以用来重放现场。",
  "chapter": "02",
  "anchor": "c02-prng",
  "auto": false
 },
 {
  "term": "向量",
  "key": "vector",
  "en": "vector",
  "meaning": "排成一列的一串数，模型里每个 token 在层与层之间都表示成向量。",
  "chapter": "03",
  "anchor": "sec-1",
  "auto": false
 },
 {
  "term": "矩阵",
  "key": "matrix",
  "en": "matrix",
  "meaning": "有行有列的一张数表，模型的权重大多以矩阵形式存放。",
  "chapter": "03",
  "anchor": "sec-1",
  "auto": false
 },
 {
  "term": "张量",
