  "anchor": "c21-parallelism"
 },
 {
  "term": "数据并行",
  "key": "data-parallelism",
  "en": "data parallelism",
  "meaning": "每张卡放一整份模型，各自处理不同的请求，几乎不用跨卡沟通。",
  "chapter": "21",
  "anchor": "c21-parallelism"
 },
 {
  "term": "气泡",
  "key": "pipeline-bubble",
  "en": "pipeline bubble",
  "meaning": "流水线开头和结尾，有工位没活可干、只能空等的时间。",
  "chapter": "21",
  "anchor": "sec-3"
 },
 {
  "term": "PCIe",
  "key": "pcie",
  "en": "PCI Express (PCIe)",
  "meaning": "主板上连接 CPU、显卡等设备的串行总线，带宽远低于显存。",
