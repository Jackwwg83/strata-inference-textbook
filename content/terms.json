  "anchor": "sec-2"
 },
 {
  "term": "GDN",
  "key": "gdn",
  "en": "Gated DeltaNet (GDN)",
  "meaning": "Strata 模型多数层的回看方式，把前文压进一块固定大小的状态，每来一个 token 擦写一次。",
