{
  "name": "strata-inference-textbook",
  "version": "1.0.0",
  "private": true,
  "description": "从 Strata 学推理系统：独立编写的中文大学 Web 教材",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "node scripts/serve.cjs",
    "dev": "node scripts/build.cjs && node scripts/serve.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:python": "python3 -m unittest discover -s labs -p 'test_*.py' -v"
  }
}
